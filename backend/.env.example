# Скопируйте в .env и заполните значения.

# --- Почта: ответы на вопросы пользователей (Mail.ru) ---
# Пароль приложения: https://help.mail.ru/mail/security/protection/external
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mail.ru
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_USE_TLS=False
EMAIL_HOST_USER=malchewski@mail.ru
EMAIL_HOST_PASSWORD=пароль_приложения_из_настроек_mail.ru
DEFAULT_FROM_EMAIL=malchewski@mail.ru

# Альтернатива Mail.ru (STARTTLS):
# EMAIL_PORT=587
# EMAIL_USE_SSL=False
# EMAIL_USE_TLS=True

# Разработка без реальной отправки (письма в консоль Django):
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

FRONTEND_URL=http://localhost:3000
SITE_NAME=Kotelkov.by
